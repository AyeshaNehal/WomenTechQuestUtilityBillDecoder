      "expressions": [
        {
          "name": "summer_avg",
          "expr": "sum(u['units'] for u in extras['usage_history'] if u['month'] in ['Jun', 'Jul', 'Aug']) / 3"
        },
        {
          "name": "winter_avg",
          "expr": "sum(u['units'] for u in extras['usage_history'] if u['month'] in ['Dec', 'Jan', 'Feb']) / 3"
        },
        {
          "name": "summer_total",
          "expr": "sum(u['units'] for u in extras['usage_history'] if u['month'] in ['Jun', 'Jul', 'Aug'])"
        },
        {
          "name": "winter_total",
          "expr": "sum(u['units'] for u in extras['usage_history'] if u['month'] in ['Dec', 'Jan', 'Feb'])"
        }
      ]
    },
    {
      "question_id": "Q8",
      "expressions": [
        {
